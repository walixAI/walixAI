# =============================================================================
# walixAI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in every value before running the app.
#
#   cp .env.example .env
#
# Variables without a default value (marked REQUIRED) will cause a Pydantic
# ValidationError on startup if left empty.
# =============================================================================


# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------

# Primary connection string used inside Railway's private network (or locally).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# REQUIRED
DATABASE_URL=postgresql://postgres:password@localhost:5432/walixai

# Optional public/proxy URL used in local development when the internal Railway
# hostname (.railway.internal) is not reachable from your machine.
# Leave blank if you are running fully inside Railway or using a local DB.
DATABASE_PUBLIC_URL=


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Redis connection string used for webhook message deduplication.
# Supports plain (redis://) and TLS (rediss://) schemes.
# REQUIRED
REDIS_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# Anthropic (Claude AI)
# -----------------------------------------------------------------------------

# Secret API key from https://console.anthropic.com/
# REQUIRED
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# Meta / WhatsApp Business API
# -----------------------------------------------------------------------------

# Permanent access token for the WhatsApp Business API.
# Generate one in the Meta Developer Console under your app → WhatsApp → API Setup.
# REQUIRED
META_WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The numeric Phone Number ID shown in Meta Developer Console → WhatsApp → API Setup.
# REQUIRED
META_PHONE_NUMBER_ID=1234567890123456

# Arbitrary secret string you set when registering the webhook in Meta Developer
# Console. The app uses it to verify the hub.verify_token handshake and to
# validate the X-Hub-Signature-256 header on every incoming event.
# REQUIRED
META_WEBHOOK_SECRET=your-webhook-secret-here


# -----------------------------------------------------------------------------
# Langfuse (LLM observability)
# -----------------------------------------------------------------------------

# Public and secret keys from your Langfuse project settings
# (https://cloud.langfuse.com or your self-hosted instance).
# REQUIRED
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Secret key used for signing JWTs and other cryptographic operations.
# Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED
SECRET_KEY=change-me-to-a-long-random-secret-value

# Runtime environment. Controls SQLAlchemy echo logging and DB URL selection.
# Accepted values: development | production
APP_ENV=development

# URL of the frontend app, used to configure CORS allowed origins.
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# RUNTIME connection — used by FastAPI and background tasks (app/core/database.py).
# Meant to end up pointing at the least-privilege `walix_app` role (no
# BYPASSRLS, no DDL — see scripts/setup_db_user.py) once Railway's env vars
# are switched over by hand. Until that migration happens, it's fine for
# this to still point at the admin role, same as today.
#
# Internal Railway URL (used in production/staging)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Public proxy URL (used locally; set APP_ENV=development to activate)
DATABASE_PUBLIC_URL=postgresql+asyncpg://user:password@public-host:port/dbname

# MIGRATIONS-ONLY connection — used exclusively by Alembic (alembic/env.py).
# MUST be an admin/superuser role: migrations run CREATE POLICY, ALTER TABLE,
# etc., which `walix_app` is deliberately not allowed to do. Optional: if
# unset, Alembic falls back to DATABASE_URL/DATABASE_PUBLIC_URL above (today's
# behavior). Only needs to diverge from those once DATABASE_URL is
# repointed to walix_app — set these to the ORIGINAL admin connection string
# at that point so migrations keep working.
# ALEMBIC_DATABASE_URL=postgresql+asyncpg://admin:password@host:5432/dbname
# ALEMBIC_DATABASE_PUBLIC_URL=postgresql+asyncpg://admin:password@public-host:port/dbname

# ── Redis ──────────────────────────────────────────────────────────────────────
# Upstash Redis (TLS). Use rediss:// for Upstash, redis:// for local.
REDIS_URL=rediss://default:password@host:6380?ssl_cert_reqs=none

# ── Auth ───────────────────────────────────────────────────────────────────────
# Long random string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-64-hex-chars

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development  # development | staging | production

# Comma-separated list of allowed CORS origins
FRONTEND_URL=http://localhost:3000

# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Meta / WhatsApp ────────────────────────────────────────────────────────────
# Verify Token: arbitrary string echoed during webhook setup GET handshake.
# Must match the value configured in the Meta webhook UI.
META_VERIFY_TOKEN=my-verify-token

# App Secret: used to validate HMAC-SHA256 signature on POST webhooks.
# Found at Meta dashboard → Settings → Basic → App Secret.
META_APP_SECRET=meta-app-secret

# ── Langfuse (LLM observability) ───────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ── Optional ───────────────────────────────────────────────────────────────────
# OpenAI — only needed for scripts/ingest_kb.py
# OPENAI_API_KEY=sk-...

# Internal Walix WA number for staff commands
# WALIX_INTERNAL_WA_NUMBER_ID=
# WALIX_INTERNAL_WA_TOKEN=

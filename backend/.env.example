# ── Database ──────────────────────────────────────────────────────────────────
# Internal Railway URL (used in production/staging)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Public proxy URL (used locally; set APP_ENV=development to activate)
DATABASE_PUBLIC_URL=postgresql+asyncpg://user:password@public-host:port/dbname

# ── Redis ──────────────────────────────────────────────────────────────────────
# Upstash Redis (TLS). Use rediss:// for Upstash, redis:// for local.
REDIS_URL=rediss://default:password@host:6380

# ── Auth ───────────────────────────────────────────────────────────────────────
# Long random string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-64-hex-chars

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development  # development | staging | production

# Comma-separated list of allowed CORS origins
FRONTEND_URL=http://localhost:3000

# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Meta / WhatsApp ────────────────────────────────────────────────────────────
# Verify Token: arbitrary string echoed during webhook setup GET handshake.
# Must match the value configured in the Meta webhook UI.
META_VERIFY_TOKEN=my-verify-token

# App Secret: used to validate HMAC-SHA256 signature on POST webhooks.
# Found at Meta dashboard → Settings → Basic → App Secret.
META_APP_SECRET=meta-app-secret

# ── Langfuse (LLM observability) ───────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ── Optional ───────────────────────────────────────────────────────────────────
# OpenAI — only needed for scripts/ingest_kb.py
# OPENAI_API_KEY=sk-...

# Internal Walix WA number for staff commands
# WALIX_INTERNAL_WA_NUMBER_ID=
# WALIX_INTERNAL_WA_TOKEN=

.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Type checkers / linters
.mypy_cache/
.dmypy.json
.ruff_cache/
.pyre/
.pytype/

# IDEs / editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter
.ipynb_checkpoints
*.ipynb

# Alembic — keep migrations, ignore local artifacts only if present
# (versions/ stays tracked)

# Logs
*.log
logs/

# Local databases / dumps
*.sqlite3
*.db

# Admin scripts: local state manifests from one-off data seeding runs
# (IDs of what was created, used by the matching purge script — not secrets,
# but not versioned state either).
scripts/admin/.*manifest*.json
*.dump

# Utel KB: PDFs de origen de las fichas de licenciatura — pesados, sin valor
# versionado más allá de la extracción (los .md normalizados en
# 03_licenciaturas/ SÍ se commitean, son la fuente de verdad legible).
scripts/admin/utel_kb_source/licenciaturas_pdfs/
